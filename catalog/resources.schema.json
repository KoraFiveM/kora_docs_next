{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koraframe.work/catalog/resources.schema.json",
  "title": "Kora resource catalog (schema v3; v2 files are still readable)",
  "type": "object",
  "required": ["schemaVersion", "resources"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"enum": [2, 3], "description": "3 adds type, creator, subpath, and top-level creators."},
    "creators": {"type": "array", "items": {"$ref": "#/$defs/creator"}, "description": "Third-party authors referenced by resources of type creator (schema v3)."},
    "resources": {"type": "array", "items": {"$ref": "#/$defs/resource"}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "safePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^?#\\s\\\\]+$"},
    "creator": {
      "type": "object",
      "required": ["id", "name", "url"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)?$"},
        "description": {"type": "string"}
      }
    },
    "release": {
      "type": "object",
      "required": ["version", "tag", "commit"],
      "additionalProperties": false,
      "properties": {
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"},
        "tag": {"type": "string", "pattern": "^v\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"},
        "commit": {"$ref": "#/$defs/sha"},
        "docsPath": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/safePath"}]},
        "entryPage": {"$ref": "#/$defs/safePath"}
      }
    },
    "resource": {
      "type": "object",
      "required": ["id", "title", "repository", "path", "group", "kind", "branch", "order", "docsPath", "entryPage", "latest", "versions"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "title": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.git$"},
        "path": {"type": "string", "description": "Relative to the server's resources/ dir, e.g. [kora]/kora_core.", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\s\\\\]+$"},
        "group": {"enum": ["pre", "kora", "standalone", "cfx-default", "default-maps", "compat", "props", "bridges", "creators", "other"]},
        "kind": {"enum": ["kora", "dependency", "optional", "internal"]},
        "branch": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$", "description": "Default branch ref."},
        "order": {"type": "integer", "minimum": 1, "description": "Install/download order in generated recipe and manifest; unique per catalog, ascending."},
        "docsPath": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/safePath"}]},
        "entryPage": {"$ref": "#/$defs/safePath"},
        "latest": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"}]},
        "docsAvailable": {"type": "boolean"},
        "defaultOn": {"type": "boolean", "description": "Only meaningful for kind optional: the resource is installed by default (pre-selected in installers, included in the generated txAdmin recipe) but the user may opt out."},
        "retired": {"type": "boolean", "description": "No longer offered by installers. Published entries are append-only, so a resource is retired instead of removed."},
        "description": {"type": "string"},
        "dependsOn": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}, "uniqueItems": true, "description": "Ids of resources this one needs; installers add them automatically."},
        "type": {"enum": ["compat", "bridge", "creator"], "description": "Schema v3. Omitted = default Kora/legacy resource. kind/group are unchanged."},
        "creator": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "description": "Creator id (required for type creator)."},
        "subpath": {"$ref": "#/$defs/safePath", "description": "Folder inside the repository that holds this resource. Currently unused by the catalog (resources live at repo root) but supported by the importer and generator."},
        "versions": {"type": "array", "items": {"$ref": "#/$defs/release"}}
      },
      "allOf": [
        {
          "if": {"required": ["type"], "properties": {"type": {"const": "creator"}}},
          "then": {"required": ["creator"], "properties": {"path": {"pattern": "^\\[creators\\]/\\[[a-z][a-z0-9_-]*\\]/[A-Za-z0-9_.-]+$"}}}
        },
        {
          "if": {"required": ["defaultOn"], "properties": {"defaultOn": {"const": true}}},
          "then": {"properties": {"kind": {"const": "optional"}}}
        },
        {
          "if": {"properties": {"kind": {"enum": ["kora", "optional"]}}},
          "then": {"properties": {"versions": {"minItems": 1}, "latest": {"type": "string"}}}
        },
        {
          "if": {"properties": {"kind": {"enum": ["dependency", "internal"]}}},
          "then": {"anyOf": [
            {"properties": {"versions": {"maxItems": 0}, "latest": {"type": "null"}}},
            {"properties": {"versions": {"minItems": 1}, "latest": {"type": "string"}}}
          ]}
        }
      ]
    }
  }
}
