{
  "name": "kora-docs-next",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm run docs:import && docusaurus start",
    "build": "npm run docs:import && docusaurus build",
    "serve": "docusaurus serve",
    "docs:import": "node scripts/import-docs.mjs",
    "test": "node --test tests/*.test.mjs",
