    "test:build": "node scripts/test-versioned-build.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "overrides": {
    "tinypool": "2.2.0",
    "serialize-javascript": "7.1.4",
    "sockjs": {
      "uuid": "11.1.1"
    }
  }
}
