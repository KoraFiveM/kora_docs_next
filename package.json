{
  "name": "kora-docs-next",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm run docs:import && npm run schema:generate && docusaurus start",
    "build": "npm run docs:import && npm run schema:generate && docusaurus build",
    "serve": "docusaurus serve",
    "docs:import": "node scripts/import-docs.mjs",
    "test": "node --test tests/*.test.mjs",
    "clear": "docusaurus clear",
    "test:build": "node scripts/test-versioned-build.mjs",
    "docs:sync": "node scripts/import-docs.mjs --sync",
    "schema:generate": "docusaurus generate-structured-data"
  },
  "dependencies": {
    "@coffeecup_tech/docusaurus-plugin-structured-data": "1.0.2",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "cosmos-docusaurus-theme": "2.2.7",
    "docusaurus-markdown-source-plugin": "2.4.0",
    "docusaurus-plugin-graph-view": "1.2.0",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "overrides": {
    "tinypool": "2.2.0",
    "serialize-javascript": "7.1.4",
    "sockjs": {
      "uuid": "11.1.1"
    }
  }
}
